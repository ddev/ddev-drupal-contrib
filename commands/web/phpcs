#!/usr/bin/env bash

#ddev-generated
## Command provided by https://github.com/ddev/ddev-drupal-contrib
## Description: Run phpcs inside the web container
## Usage: phpcs [flags] [args]
## Example: "ddev phpcs" or "ddev phpcs -n"
## Example: "ddev phpcs src/Form/MyForm.php"
## ExecRaw: true

set -eu -o pipefail

if ! command -v phpcs >/dev/null; then
  echo "phpcs is not available. You may need to 'ddev composer install'"
  exit 1
fi
test -e phpcs.xml.dist || curl -fsSL -O https://git.drupalcode.org/project/gitlab_templates/-/raw/default-ref/assets/phpcs.xml.dist
# Scan the whole project unless a path to scan is given.
SCAN_PATH=$DDEV_DOCROOT/$DRUPAL_PROJECTS_PATH
for arg in "$@"; do
  if [[ $arg != -* && -e $arg ]]; then
    SCAN_PATH=
    break
  fi
done
phpcs -s --report-full --report-summary --report-source ${SCAN_PATH:+"$SCAN_PATH"} --ignore=*/.ddev/* "$@"
