## Description: Run phpcbf inside the web container
## Usage: phpcbf [flags] [args]
## Example: "ddev phpcbf" or "ddev phpcbf -n"
## Example: "ddev phpcbf src/Form/MyForm.php"
## ExecRaw: true

set -eu -o pipefail

if ! command -v phpcbf >/dev/null; then
  echo "phpcbf is not available. You may need to 'ddev composer install'"
  exit 1
fi
test -e phpcs.xml.dist || curl -fsSL -O https://git.drupalcode.org/project/gitlab_templates/-/raw/default-ref/assets/phpcs.xml.dist
# Fix the whole project unless a path to fix is given.
SCAN_PATH=$DDEV_DOCROOT/$DRUPAL_PROJECTS_PATH
for arg in "$@"; do
  if [[ $arg != -* && -e $arg ]]; then
    SCAN_PATH=
    break
  fi
done
phpcbf -s --report-full --report-summary --report-source ${SCAN_PATH:+"$SCAN_PATH"} --ignore=*/.ddev/* "$@"
